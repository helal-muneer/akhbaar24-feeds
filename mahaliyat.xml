    <item>
      <title>"الأرصاد" تتوقع رياحًا على الرياض والشرقية وتبوك</title>
      <link>https://www.akhbaar24.com/%D9%85%D8%AD%D9%84%D9%8A%D8%A7%D8%AA/%D8%A7%D9%84%D8%A3%D8%B1%D8%B5%D8%A7%D8%AF-%D8%AA%D8%AA%D9%88%D9%82%D8%B9-%D8%B1%D9%8A%D8%A7%D8%AD%D8%A7-%D8%B9%D9%84%D9%89-%D8%A7%D9%84%D8%B1%D9%8A%D8%A7%D8%B6-%D9%88%D8%A7%D9%84%D8%B4%D8%B1%D9%82%D9%8A%D8%A9-%D9%88%D8%AA%D8%A8%D9%88%D9%83-765004</link>
