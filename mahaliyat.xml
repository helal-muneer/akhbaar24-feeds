      <title>أمطار ورياح على أجزاء من جازان وعسير والباحة</title>
      <link>https://www.akhbaar24.com/%D9%85%D8%AD%D9%84%D9%8A%D8%A7%D8%AA/%D8%A3%D9%85%D8%B7%D8%A7%D8%B1-%D9%88%D8%B1%D9%8A%D8%A7%D8%AD-%D8%B9%D9%84%D9%89-%D8%A3%D8%AC%D8%B2%D8%A7%D8%A1-%D9%85%D9%86-%D8%AC%D8%A7%D8%B2%D8%A7%D9%86-%D9%88%D8%B9%D8%B3%D9%8A%D8%B1-%D9%88%D8%A7%D9%84%D8%A8%D8%A7%D8%AD%D8%A9-764906</link>
