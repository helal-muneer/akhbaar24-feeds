      <title>مدني تنومة يباشر حريقًا في منطقة جبلية</title>
      <link>https://www.akhbaar24.com/%D8%AD%D9%88%D8%A7%D8%AF%D8%AB/%D9%85%D8%AF%D9%86%D9%8A-%D8%AA%D9%86%D9%88%D9%85%D8%A9-%D9%8A%D8%A8%D8%A7%D8%B4%D8%B1-%D8%AD%D8%B1%D9%8A%D9%82%D8%A7-%D9%81%D9%8A-%D9%85%D9%86%D8%B7%D9%82%D8%A9-%D8%AC%D8%A8%D9%84%D9%8A%D8%A9-765663</link>
      <guid isPermaLink="true">https://www.akhbaar24.com/%D8%AD%D9%88%D8%A7%D8%AF%D8%AB/%D9%85%D8%AF%D9%86%D9%8A-%D8%AA%D9%86%D9%88%D9%85%D8%A9-%D9%8A%D8%A8%D8%A7%D8%B4%D8%B1-%D8%AD%D8%B1%D9%8A%D9%82%D8%A7-%D9%81%D9%8A-%D9%85%D9%86%D8%B7%D9%82%D8%A9-%D8%AC%D8%A8%D9%84%D9%8A%D8%A9-765663</guid>
