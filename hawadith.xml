      <title>مرور جدة يباشر حادثًا مروريًا إثر عدم إعطاء الأفضلية</title>
      <link>https://www.akhbaar24.com/%D8%AD%D9%88%D8%A7%D8%AF%D8%AB/%D9%85%D8%B1%D9%88%D8%B1-%D8%AC%D8%AF%D8%A9-%D9%8A%D8%A8%D8%A7%D8%B4%D8%B1-%D8%AD%D8%A7%D8%AF%D8%AB%D8%A7-%D9%85%D8%B1%D9%88%D8%B1%D9%8A%D8%A7-%D8%A5%D8%AB%D8%B1-%D8%B9%D8%AF%D9%85-%D8%A5%D8%B9%D8%B7%D8%A7%D8%A1-%D8%A7%D9%84%D8%A3%D9%81%D8%B6%D9%84%D9%8A%D8%A9-765043</link>
